# ----- Database -----
# Postgres connection string used by Prisma.
DATABASE_URL="postgresql://app:app@127.0.0.1:5432/epub?schema=public"

# ----- Auth.js / NextAuth -----
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
# Base URL of the app (used for OAuth callbacks).
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth credentials (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ----- Email (one-time passcode sign-in) -----
# When SMTP_HOST and EMAIL_FROM are set, sign-in codes are emailed via SMTP.
# If unset, codes are logged to the server console (fine for local dev).
EMAIL_FROM="Lumen <no-reply@example.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# ----- Storage -----
# Directory on disk where uploaded EPUB files are stored (local/dev/self-hosted).
STORAGE_DIR="./storage/books"
# On Vercel (or any serverless host), set a Vercel Blob token instead. When this
# is present, uploads are stored in Blob and STORAGE_DIR is ignored.
BLOB_READ_WRITE_TOKEN=""

# ----- Test-only login bypass -----
# When "true", enables a deterministic credentials provider for automated tests.
# MUST be unset/false in production.
ENABLE_TEST_LOGIN="false"
